ANTHROPIC_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

# One entry per person, as name:code, separated by commas.
# Generate a code with: py -c "import secrets; print(secrets.token_urlsafe(12))"
ACCESS_CODES=yourname:a-long-random-code,sister1:another-long-random-code

# Country code used for "where to watch" results
REGION=US

# Defaults to a local SQLite file. Set this when hosting online.
# DATABASE_URL=sqlite:///watchstash.db